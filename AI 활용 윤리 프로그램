    def load_models(self):
        """AI 모델 로드"""
        try:
            self.status_label.config(text="AI 모델 로딩 중... (약 30-60초 소요)", foreground="orange")
            self.root.update()
            
            print("모델 로딩 시작...")
            
            # Zero-shot 분류 (더 정확한 카테고리 분류)
            self.zero_shot_classifier = pipeline(
                "zero-shot-classification",
                model="facebook/bart-large-mnli",
                device=0 if torch.cuda.is_available() else -1
            )
            
            self.models_loaded = True
            self.status_label.config(text="AI 모델 준비 완료 ✓", foreground="green")
            self.analyze_btn.config(state="normal")
            print("모델 로드 완료")
            
        except Exception as e:
            self.status_label.config(text=f"모델 로드 실패: {str(e)}", foreground="red")
            print(f"모델 로드 오류: {str(e)}")
    
    def split_into_sentences(self, text: str) -> List[str]:
        """텍스트를 문장 단위로 분할"""
        # 다양한 문장 구분자로 분할
        sentences = re.split(r'(?<=[.!?。！？\n])\s+|(?<=\n)\s*', text)
        sentences = [s.strip() for s in sentences if s.strip() and len(s.strip()) > 1]
        return sentences
    
    def analyze_text_async(self):
        """비동기 텍스트 분석"""
        if not self.models_loaded:
            messagebox.showwarning("경고", "AI 모델이 아직 로딩 중입니다. 잠시만 기다려주세요.")
            return
        
        # 별도 스레드에서 분석 수행
        threading.Thread(target=self.analyze_text, daemon=True).start()
    
    def analyze_text(self):
        """텍스트 분석 (메인 분석 함수)"""
        self.current_text = self.text_input.get("1.0", tk.END).strip()
        
        if not self.current_text:
            messagebox.showwarning("경고", "분석할 텍스트를 입력해주세요.")
            return
        
        try:
            self.status_label.config(text="분석 중...", foreground="orange")
            self.root.update()
            
            # 텍스트를 문장 단위로 분할
            sentences = self.split_into_sentences(self.current_text)
            print(f"텍스트가 {len(sentences)}개의 문장으로 분할되었습니다.")
            
            # 분석 수행
            self.analysis_result = {
                "timestamp": datetime.now().isoformat(),
                "text_length": len(self.current_text),
                "sentences_count": len(sentences),
                "results": {}
            }
            
            # 각 카테고리별 분석
            categories = {
                "race": "인종 차별 표현 (특정 인종을 비하하거나 불이익을 암시하는 표현)",
                "gender": "성별 차별 표현 (근거없는 성별 고정관념 및 차별)",
                "privacy": "개인정보 노출 (민감한 개인정보 포함)",
                "vulnerable": "취약계층 차별 (장애인, 고령자, 저소득층 혐오)"
            }
            
            for key, description in categories.items():
                risk_level, confidence, explanation, sentence_results = self.analyze_category_sentence_level(
                    sentences, description, key
                )
                self.analysis_result["results"][key] = {
                    "risk_level": risk_level,
                    "confidence": confidence,
                    "explanation": explanation,
                    "sentence_results": sentence_results
                }
                self.update_result_display(key, risk_level, confidence)
            
            self.process_btn.config(state="normal")
            self.feedback_submit_btn.config(state="normal")
            self.status_label.config(text="분석 완료 ✓", foreground="green")
            
            messagebox.showinfo("완료", "분석이 완료되었습니다.")
            
        except Exception as e:
            self.status_label.config(text=f"분석 오류: {str(e)}", foreground="red")
            messagebox.showerror("오류", f"분석 중 오류 발생: {str(e)}")
    
    def analyze_category_sentence_level(self, sentences: List[str], category_description: str, 
                                        category_key: str) -> Tuple[str, int, str, List]:
        """문장 단위로 카테고리 분석"""
        try:
            risky_sentences = []
            confidence_scores = []
            risk_levels_found = {"위험": 0, "경고": 0, "주의": 0, "안전": 0}
            sentence_results = []
            
            candidate_labels = [
                f"{category_description}",
                "안전한 표현 (위험 요소 없음)"
            ]
            
            # 각 문장별로 분석
            for sentence_idx, sentence in enumerate(sentences):
                if not sentence.strip() or len(sentence.strip()) < 2:
                    continue
                
                try:
                    # 각 문장 분석
                    result = self.zero_shot_classifier(
                        sentence, 
                        candidate_labels, 
                        multi_class=False
                    )
                    
                    top_label = result['labels'][0]
                    confidence = int(result['scores'][0] * 100)
                    confidence_scores.append(confidence)
                    
                    # 더 엄격한 위험도 기준
                    if confidence > 80 and "차별" in top_label:
                        sentence_risk_level = "위험"
                    elif confidence > 65 and "차별" in top_label:
                        sentence_risk_level = "경고"
                    elif confidence > 50 and "차별" in top_label:
                        sentence_risk_level = "주의"
                    else:
                        sentence_risk_level = "안전"
                    
                    risk_levels_found[sentence_risk_level] += 1
                    
                    # 위험한 문장 저장
                    if sentence_risk_level != "안전":
                        risky_sentences.append(sentence)
                        sentence_results.append({
                            "sentence": sentence,
                            "risk_level": sentence_risk_level,
                            "confidence": confidence,
                            "index": sentence_idx
                        })
                    
                except Exception as e:
                    print(f"문장 {sentence_idx} 분석 오류: {str(e)}")
                    continue
            
            # 최종 위험도 결정 (문장 단위 분석 결과 종합)
            if risk_levels_found["위험"] > 0:
                final_risk_level = "위험"
            elif risk_levels_found["경고"] > 0:
                final_risk_level = "경고"
            elif risk_levels_found["주의"] > 0:
                final_risk_level = "주의"
            else:
                final_risk_level = "안전"
            
            # 최종 신뢰도 (위험한 문장들의 평균 신뢰도)
            if sentence_results:
                dangerous_confidences = [s["confidence"] for s in sentence_results]
                final_confidence = int(np.mean(dangerous_confidences))
            else:
                final_confidence = 0
            
            # 설명 생성
            explanation = self.generate_category_explanation_sentence_level(
                risky_sentences, category_key, final_risk_level, final_confidence, 
                len(sentences), risk_levels_found, sentence_results
            )
            
            return final_risk_level, final_confidence, explanation, sentence_results
            
        except Exception as e:
            print(f"카테고리 분석 오류 ({category_key}): {str(e)}")
            return "분석 실패", 0, f"오류: {str(e)}", []
    
    def generate_category_explanation_sentence_level(self, risky_sentences: List[str], category_key: str, 
                                                    risk_level: str, confidence: int, 
                                                    total_sentences: int, risk_levels_found: Dict,
                                                    sentence_results: List) -> str:
        """카테고리별 설명 생성 (문장 단위 분석)"""
        
        explanation = ""
        
        # 발견된 위험한 문장 표시
        if risk_level != "안전" and sentence_results:
            explanation += "⚠️ 발견된 위험한 문장:\n"
            # 신뢰도 순으로 정렬 후 상위 5개만 표시
            sorted_results = sorted(sentence_results, key=lambda x: x['confidence'], reverse=True)[:5]
            for i, result in enumerate(sorted_results, 1):
                risk_badge = "🔴 위험" if result['risk_level'] == "위험" else \
                            "🟠 경고" if result['risk_level'] == "경고" else "🟡 주의"
                explanation += f"  {i}. {risk_badge} ({result['confidence']}%) \"{result['sentence']}\"\n"
            explanation += "\n"
        elif risk_level != "안전":
            explanation += "⚠️ 위험한 표현이 감지되었으나 구체적인 부분 식별 불가\n\n"
        
        explanation += f"판단 결과: {risk_level} (신뢰도: {confidence}%)\n\n"
        explanation += f"문장별 분석 결과:\n"
        explanation += f"  • 전체 문장 수: {total_sentences}개\n"
        explanation += f"  • 🔴 위험한 문장: {risk_levels_found['위험']}개\n"
        explanation += f"  • 🟠 경고 수준 문장: {risk_levels_found['경고']}개\n"
        explanation += f"  • 🟡 주의 수준 문장: {risk_levels_found['주의']}개\n"
        explanation += f"  • ✅ 안전한 문장: {risk_levels_found['안전']}개\n\n"
        
        # 카테고리별 추가 설명
        explanations = {
            "race": "이 텍스트는 특정 인종을 비하하거나 차별하는 표현을 포함할 가능성이 있습니다.",
            "gender": "이 텍스트는 특정 성별에 대한 고정관념이나 차별 표현을 포함할 가능성이 있습니다.",
            "privacy": "이 텍스트는 전화번호, 이메일, 개인 신상정보 등 민감한 개인정보를 포함할 수 있습니다.",
            "vulnerable": "이 텍스트는 장애인, 고령자, 저소득층 등 취약계층을 대상으로 한 혐오 표현을 포함할 수 있습니다."
        }
        
        if risk_level != "안전":
            explanation += f"주의: {explanations.get(category_key, '위험한 표현이 감지되었습니다.')}"
        
        return explanation
    
    def update_result_display(self, category_key: str, risk_level: str, confidence: int):
        """결과 표시 업데이트"""
        color_map = {
            "안전": "green",
            "주의": "orange",
            "경고": "red",
            "위험": "darkred",
            "분석 실패": "gray"
        }
        
        label = self.result_labels[category_key]["risk"]
        label.config(text=risk_level, foreground=color_map.get(risk_level, "black"))
        
        conf_label = self.result_labels[category_key]["confidence"]
        conf_label.config(text=f"({confidence}%)")
    
