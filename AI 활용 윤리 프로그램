        explanation = self.generate_detailed_explanation()
        process_text.insert("1.0", explanation)
        process_text.config(state="disabled")
        
        # 닫기 버튼
        close_btn = ttk.Button(process_window, text="닫기", command=process_window.destroy)
        close_btn.pack(pady=10)
    
    def generate_detailed_explanation(self) -> str:
        """상세 판단 과정 설명 생성"""
        explanation = "=" * 100 + "\n"
        explanation += "                         🤖 AI 판단 과정 상세 분석 (문장 단위)\n"
        explanation += "=" * 100 + "\n\n"
        
        explanation += f"분석 시간: {self.analysis_result['timestamp']}\n"
        explanation += f"입력 텍스트 길이: {self.analysis_result['text_length']} 자\n"
        explanation += f"분석된 문장 수: {self.analysis_result['sentences_count']}개\n\n"
        explanation += "=" * 100 + "\n\n"
        
        category_names = {
            "race": "【인종 차별 표현 분석】",
            "gender": "【성별 차별 표현 분석】",
            "privacy": "【개인정보 노출 분석】",
            "vulnerable": "【취약계층 차별 표현 분석】"
        }
        
        for category_key, category_name in category_names.items():
            result = self.analysis_result["results"][category_key]
            
            explanation += f"{category_name}\n"
            explanation += f"최종 위험 수준: {result['risk_level']}\n"
            explanation += f"신뢰도: {result['confidence']}%\n\n"
            
            explanation += "분석 상세:\n"
            explanation += result['explanation'] + "\n\n"
            
            # 문장별 세부 분석 결과
            if result['sentence_results']:
                explanation += "문장별 상세 분석:\n"
                sorted_results = sorted(result['sentence_results'], 
                                      key=lambda x: x['confidence'], reverse=True)[:10]
                for idx, sent_result in enumerate(sorted_results, 1):
                    risk_emoji = "🔴" if sent_result['risk_level'] == "위험" else \
                                "🟠" if sent_result['risk_level'] == "경고" else "🟡"
                    explanation += f"  {idx}. {risk_emoji} [{sent_result['risk_level']}] "
                    explanation += f"({sent_result['confidence']}%) \n"
                    explanation += f"      \"{sent_result['sentence']}\"\n"
                explanation += "\n"
            
            explanation += "-" * 100 + "\n\n"
        
        explanation += "=" * 100 + "\n"
        explanation += "💡 개선된 AI 분석 방식:\n"
        explanation += "1. 문장 단위 분석: 전체 텍스트를 개별 문장으로 분할\n"
        explanation += "2. 세밀한 검토: 각 문장을 독립적으로 Zero-shot Classification 수행\n"
        explanation += "3. 엄격한 기준: 80% 이상 신뢰도만 '위험', 65% 이상만 '경고' 등급 부여\n"
        explanation += "4. 결과 종합: 모든 문장의 분석 결과를 종합하여 최종 판단\n"
        explanation += "5. 신뢰도 계산: 위험한 문장들의 신뢰도 평균값으로 최종 신뢰도 산정\n\n"
        
        explanation += "✅ 주요 개선사항:\n"
        explanation += "• 문장 단위 검토: 미묘한 차별 표현도 정확히 감지\n"
        explanation += "• 엄격한 판정 기준: 거짓 경보 방지, 정확도 향상\n"
        explanation += "• 신뢰도 투명성: 각 위험 문장의 신뢰도 점수 공개\n"
        explanation += "• 순위 정렬: 가장 위험한 문장부터 우선 표시\n\n"
        
        explanation += "⚠️ 주의사항:\n"
