    def submit_feedback(self):
        """피드백 제출"""
        feedback_content = self.feedback_text.get("1.0", tk.END).strip()
        
        if not feedback_content:
            messagebox.showwarning("경고", "피드백 내용을 입력해주세요.")
            return
        
        if not self.analysis_result:
            messagebox.showwarning("경고", "분석 결과가 없습니다.")
            return
        
        # 피드백 저장
        feedback_entry = {
            "timestamp": datetime.now().isoformat(),
            "text": self.current_text,
            "analysis_result": self.analysis_result,
            "feedback": feedback_content
        }
        
        self.feedback_data.append(feedback_entry)
        self.save_feedback_data()
        
        self.feedback_text.delete("1.0", tk.END)
        messagebox.showinfo("성공", "피드백이 제출되었습니다.\n프로그램 개선에 사용되겠습니다.")
    
    def save_feedback_data(self):
        """피드백 데이터 저장"""
        try:
            with open(self.feedback_file, 'w', encoding='utf-8') as f:
                json.dump(self.feedback_data, f, ensure_ascii=False, indent=2)
        except Exception as e:
            messagebox.showerror("오류", f"피드백 저장 중 오류: {str(e)}")
    
    def load_feedback_data(self):
        """피드백 데이터 로드"""
        try:
            if os.path.exists(self.feedback_file):
                with open(self.feedback_file, 'r', encoding='utf-8') as f:
                    self.feedback_data = json.load(f)
        except Exception as e:
            print(f"피드백 로드 중 오류: {str(e)}")
            self.feedback_data = []
    
    def view_feedback_history(self):
        """피드백 기록 보기"""
        if not self.feedback_data:
            messagebox.showinfo("알림", "저장된 피드백이 없습니다.")
            return
        
        # 새 윈도우 생성
        history_window = tk.Toplevel(self.root)
        history_window.title("피드백 기록")
        history_window.geometry("800x600")
        history_window.configure(bg="#f5f5f5")
        
        # 제목
        title = ttk.Label(history_window, text=f"📝 피드백 기록 ({len(self.feedback_data)}개)", 
                         font=("Arial", 12, "bold"))
        title.pack(pady=10)
        
        # 스크롤 텍스트 영역
        text_frame = ttk.Frame(history_window)
        text_frame.pack(fill="both", expand=True, padx=10, pady=10)
        
        history_text = scrolledtext.ScrolledText(text_frame, height=20, width=90, 
                                                wrap=tk.WORD, font=("Arial", 9))
        history_text.pack(fill="both", expand=True)
        
        # 피드백 기록 표시
        for i, feedback in enumerate(self.feedback_data, 1):
            history_text.insert(tk.END, f"\n{'='*80}\n")
            history_text.insert(tk.END, f"피드백 #{i}\n")
            history_text.insert(tk.END, f"시간: {feedback['timestamp']}\n")
            history_text.insert(tk.END, f"원문: {feedback['text'][:100]}...\n")
            history_text.insert(tk.END, f"피드백: {feedback['feedback']}\n")
        
        history_text.config(state="disabled")
        
        # 닫기 버튼
        close_btn = ttk.Button(history_window, text="닫기", command=history_window.destroy)
        close_btn.pack(pady=10)
    
    def clear_text(self):
        """텍스트 초기화"""
        self.text_input.delete("1.0", tk.END)
        self.feedback_text.delete("1.0", tk.END)
        self.analysis_result = None
        self.current_text = ""
        
        for key in self.category_keys:
            self.result_labels[key]["risk"].config(text="검사 대기 중", foreground="gray")
            self.result_labels[key]["confidence"].config(text="")
        
        self.process_btn.config(state="disabled")
        self.feedback_submit_btn.config(state="disabled")

