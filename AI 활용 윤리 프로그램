        """판단 과정 표시"""
        if not self.analysis_result:
            messagebox.showwarning("경고", "먼저 텍스트를 분석해주세요.")
            return
        
        # 새 윈도우 생성
        process_window = tk.Toplevel(self.root)
        process_window.title("판단 과정 설명")
        process_window.geometry("900x750")
        process_window.configure(bg="#f5f5f5")
        
        # 제목
        title = ttk.Label(process_window, text="🤖 AI 판단 과정 상세 분석", 
                         font=("Arial", 14, "bold"))
        title.pack(pady=10)
        
        # 스크롤 텍스트 영역
        text_frame = ttk.Frame(process_window)
